<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<?mso-application progid="Word.Document"?>
<w:wordDocument xmlns:w="http://schemas.microsoft.com/office/word/2003/wordml"
                xmlns:v="urn:schemas-microsoft-com:vml"
                xmlns:w10="urn:schemas-microsoft-com:office:word"
                xmlns:sl="http://schemas.microsoft.com/schemaLibrary/2003/core"
                xmlns:aml="http://schemas.microsoft.com/aml/2001/core"
                xmlns:wx="http://schemas.microsoft.com/office/word/2003/auxHint"
                xmlns:o="urn:schemas-microsoft-com:office:office"
                w:macrosPresent="no" w:embeddedObjPresent="no" w:ocxPresent="no" xml:space="preserve">
  <w:fonts>
    <w:defaultFonts w:ascii="等线" w:fareast="等线" w:h-ansi="等线" w:cs="Times New Roman"/>
  </w:fonts>
  <w:styles>
    <w:style w:type="paragraph" w:default="on" w:styleId="Normal">
      <w:name w:val="Normal"/>
      <w:rPr>
        <w:rFonts w:ascii="等线" w:fareast="等线" w:h-ansi="等线" w:cs="Times New Roman"/>
        <w:sz w:val="22"/>
        <w:sz-cs w:val="22"/>
      </w:rPr>
    </w:style>
  </w:styles>
  <w:body>
    <!-- 大标题：等线，一号（26pt/52），加粗，靠左/居中 -->
    <w:p>
      <w:pPr>
        <w:jc w:val="left"/>
        <w:spacing w:before="120" w:after="160"/>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="等线" w:fareast="等线" w:h-ansi="等线"/>
          <w:b/>
          <w:sz w:val="52"/>
          <w:sz-cs w:val="52"/>
        </w:rPr>
        <w:t>【活动全称】工作总结</w:t>
      </w:r>
    </w:p>

    <!-- 一、活动名称：三号等线加粗 -->
    <w:p>
      <w:pPr>
        <w:spacing w:before="160" w:after="80"/>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:b/>
          <w:sz w:val="32"/>
          <w:sz-cs w:val="32"/>
        </w:rPr>
        <w:t>一、活动名称</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:spacing w:after="120"/>
      </w:pPr>
      <w:r>
        <w:t>“活动品牌”第X期活动（活动主题全称）</w:t>
      </w:r>
    </w:p>

    <!-- 二、活动来源/背景 -->
    <w:p>
      <w:pPr>
        <w:spacing w:before="160" w:after="80"/>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:b/>
          <w:sz w:val="32"/>
          <w:sz-cs w:val="32"/>
        </w:rPr>
        <w:t>二、活动来源</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:spacing w:after="120" w:line="300" w:line-rule="auto"/>
      </w:pPr>
      <w:r>
        <w:t>【阐明活动立项动因、面向群体、拟解决的痛点及希望达成的育人或文化建设目标】</w:t>
      </w:r>
    </w:p>

    <!-- 三、策划分工 -->
    <w:p>
      <w:pPr>
        <w:spacing w:before="160" w:after="80"/>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:b/>
          <w:sz w:val="32"/>
          <w:sz-cs w:val="32"/>
        </w:rPr>
        <w:t>三、策划分工</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:rPr><w:b/></w:rPr>
        <w:t>• 材料准备：</w:t>
      </w:r>
      <w:r>
        <w:t>负责人【姓名】。负责统筹采购/清点材料设备，确保适配规模。</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:rPr><w:b/></w:rPr>
        <w:t>• 宣传推送：</w:t>
      </w:r>
      <w:r>
        <w:t>负责人【姓名】。活动前制作发布预热推送，活动后负责宣传文稿。</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:rPr><w:b/></w:rPr>
        <w:t>• 场地与设备：</w:t>
      </w:r>
      <w:r>
        <w:t>负责人【姓名】。提前预约教室/场地，调试音响设备与课件。</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:rPr><w:b/></w:rPr>
        <w:t>• 现场执行与摄影：</w:t>
      </w:r>
      <w:r>
        <w:t>负责人【姓名】。负责签到组织、现场过程及作品细节抓拍留存。</w:t>
      </w:r>
    </w:p>

    <!-- 四、具体实施 -->
    <w:p>
      <w:pPr>
        <w:spacing w:before="160" w:after="80"/>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:b/>
          <w:sz w:val="32"/>
          <w:sz-cs w:val="32"/>
        </w:rPr>
        <w:t>四、具体实施（活动过程）</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:rPr><w:b/></w:rPr>
        <w:t>1. 签到与开场环节：</w:t>
      </w:r>
      <w:r>
        <w:t>【写清具体组织方式、人员到位情况与破冰引导】</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:rPr><w:b/></w:rPr>
        <w:t>2. 教学讲解与示范：</w:t>
      </w:r>
      <w:r>
        <w:t>【写清讲解人、演示步骤与技术要领解答】</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:rPr><w:b/></w:rPr>
        <w:t>3. 动手实践与创作交流：</w:t>
      </w:r>
      <w:r>
        <w:t>【写清学生动手制作状态、互动讨论与巡场答疑】</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:rPr><w:b/></w:rPr>
        <w:t>4. 展示点评与合影收尾：</w:t>
      </w:r>
      <w:r>
        <w:t>【写清作品展示、互评交流及现场收尾清理】</w:t>
      </w:r>
    </w:p>

    <!-- 五、总结归档 -->
    <w:p>
      <w:pPr>
        <w:spacing w:before="160" w:after="80"/>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:b/>
          <w:sz w:val="32"/>
          <w:sz-cs w:val="32"/>
        </w:rPr>
        <w:t>五、总结归档</w:t>
      </w:r>
    </w:p>
    <w:p><w:r><w:t>• 前期材料：活动策划案、分工排班表、报名通知及名单</w:t></w:r></w:p>
    <w:p><w:r><w:t>• 中期材料：签到表、现场演示课件PPT、现场高清照片及视频</w:t></w:r></w:p>
    <w:p><w:r><w:t>• 后期材料：作品电子扫描档、满意度调查问卷结果、新闻稿件</w:t></w:r></w:p>
    <w:p><w:r><w:t>• 宣传材料：微信公众号前后推送推文、排版原件及阅读量统计数据</w:t></w:r></w:p>

    <!-- 六、活动成果 -->
    <w:p>
      <w:pPr>
        <w:spacing w:before="160" w:after="80"/>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:b/>
          <w:sz w:val="32"/>
          <w:sz-cs w:val="32"/>
        </w:rPr>
        <w:t>六、活动成果</w:t>
      </w:r>
    </w:p>
    <w:p><w:r><w:t>1. 量化成效：本次活动实到参与同学【X】人，完成作品【X】件，问卷回收【X】份，总体满意度达【X%】。</w:t></w:r></w:p>
    <w:p><w:r><w:t>2. 质性成效：同学们在……方面得到有效锻炼，提炼出……经验方法。</w:t></w:r></w:p>

    <!-- 七、不足与改进 -->
    <w:p>
      <w:pPr>
        <w:spacing w:before="160" w:after="80"/>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:b/>
          <w:sz w:val="32"/>
          <w:sz-cs w:val="32"/>
        </w:rPr>
        <w:t>七、不足与改进</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r><w:rPr><w:b/></w:rPr><w:t>【不足之处】：</w:t></w:r>
      <w:r><w:t>1. 部分物料准备数量与实际消耗存在偏差；2. 现场各环节时间把控略有紧凑。</w:t></w:r>
    </w:p>
    <w:p>
      <w:r><w:rPr><w:b/></w:rPr><w:t>【改进措施】：</w:t></w:r>
      <w:r><w:t>1. 提前调研需求，物料按照实际报名人数上浮10%-15%备用；2. 安排专人把控环节时间节点。</w:t></w:r>
    </w:p>

    <!-- 八、工作感想 -->
    <w:p>
      <w:pPr>
        <w:spacing w:before="160" w:after="80"/>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:b/>
          <w:sz w:val="32"/>
          <w:sz-cs w:val="32"/>
        </w:rPr>
        <w:t>八、工作感想</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr><w:spacing w:after="160" w:line="300" w:line-rule="auto"/></w:pPr>
      <w:r>
        <w:t>【总结部门工作收获、协同体验，以及针对下一期品牌活动的推进建议】</w:t>
      </w:r>
    </w:p>

